{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["row_id", "status", "problem_text", "prompt_match", "changes", "mathematical_invariants", "source_issues", "remaining_foreign_context", "checks_needed"],
  "properties": {
    "row_id": {"type": "string"},
    "status": {"enum": ["candidate", "blocked"]},
    "problem_text": {"type": ["string", "null"]},
    "prompt_match": {"enum": ["identical", "analogous", "regenerated"]},
    "changes": {"type": "array", "items": {"type": "object"}},
    "mathematical_invariants": {"type": "object"},
    "source_issues": {"type": "array", "items": {"type": "string"}},
    "remaining_foreign_context": {"type": "array", "items": {"type": "string"}},
    "checks_needed": {"type": "array", "items": {"type": "string"}}
  }
}
